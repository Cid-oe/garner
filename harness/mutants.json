  },
  {
    "id": "Q3-case-insensitive-type",
    "quirk": "Customer types are trimmed and case-insensitive",
    "replacements": [
      ["t.equalsIgnoreCase(TYPE_WHOLESALE)", "t.equals(TYPE_WHOLESALE)"],
      ["t.equalsIgnoreCase(TYPE_STAFF)", "t.equals(TYPE_STAFF)"]
    ]
  },
  {
    "id": "Q4-weekend-rollover",
    "quirk": "Due dates on a weekend roll forward to Monday",
    "replacements": [
      ["cal.add(Calendar.DAY_OF_MONTH, 2);", ";"],
      ["cal.add(Calendar.DAY_OF_MONTH, 1);", ";"]
    ]
  }
